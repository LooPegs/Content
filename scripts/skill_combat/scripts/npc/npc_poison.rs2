[ai_timer,_] ~npc_poison_timer;

[proc,npc_poison_timer]
// damage npc

if (%npc_poison > 0) {
    npc_damage(^hitmark_poison, %npc_poison);
    %npc_poison = sub(%npc_poison, 1);
    // They died
    if (npc_stat(hitpoints) = 0){
        npc_queue(3, 0, 0);
    }
} else {
    ~npc_poison_clear;
    return;
}






[proc,npc_poison_clear]
%npc_poison = 0;
npc_settimer(0); // npc_cleartimer?


[proc,npc_poison_start](int $severity)
//need to make npcs with preexisting timers immune? does weird stuff with timer
if (~npc_is_attackable() = false) {
    return;
}
if (map_members = ^false) {
    return;
}

if ($severity > %npc_poison) {
    npc_settimer(10);
    %npc_poison = $severity;
}
