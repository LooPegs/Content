// begins combat
[label,player_melee_attack]
p_stopaction;
if (~npc_is_attackable() = false) {
    return;
}

if (%action_delay > map_clock) {
    p_opnpc(2); // it is guaranteed here that we are already within op distance
    return;
}

if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    return; // this means the npc is not avail to fight i.e dead
}

def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
def_int $attack_rate;
if ($weapon = null) {
    $attack_rate = 4;
}
else {
    $attack_rate = oc_param($weapon, attackrate);
}

def_int $maxhit = %com_maxhit;

//reset moveset after certain amount of time
if (%com_moveset_timer <= map_clock & %com_moveset ! 0) {
    %com_moveset = 0;
}

if($weapon = bronze_battleaxe) {
    switch_int (%com_moveset) {
        case 0 :
            %com_moveset_timer = add(map_clock, 30);
            %com_attackanim = human_axe_hack;
            %com_moveset = add(%com_moveset, 1);
        case 1 :
            %com_moveset_timer = add(map_clock, 30);
            %com_attackanim = human_sword_stab;
            %com_moveset = 2;
        case 2 :
            %com_moveset_timer = add(map_clock, 30);
            %com_attackanim = human_dhsword_spin;
            $attack_rate = 8;
            $maxhit = scale($maxhit, 10, 25);
            %com_moveset = 0;
        case default :
            error("invalid moveset id <tostring(%com_moveset)>");
    }
}


// check hit, give combat xp
def_int $damage = 0;
if (~player_npc_hit_roll(%damagetype) = true) {

    if ($weapon = bronze_battleaxe & %com_moveset = 2) {
        $maxhit = scale($maxhit, 10, 15);
    }

    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (npc_param(demonbane_vulnerable) = true & inv_total(worn, silverlight) > 0) {
        $maxhit = scale(160, 100, %com_maxhit);
    }

    def_int $minhit = 0;
    //check crit
    if (~crit(%damagetype) = 1) {
        $attack_rate = sub($attack_rate, 1);
        $minhit = divide($maxhit,2);
        spotanim_pl(sp_attackglow_red, 0, 0);
        sound_synth(cleave, 0, 0);
    }

    $damage = ~damage_roll($minhit, $maxhit, npc_param(max_dealt), 0, 1);
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}

if ($weapon ! null) {
    def_int $poison_severity = oc_param($weapon, poison_severity);
    // if ($damage > 0 & $poison_severity > 0 & random(4) = 0) { // 1/4 chance to poison
    if ($damage > 0 & $poison_severity > 0) { // 1/4 chance to poison
        // poison npc
        npc_say("im poisoned");
        ~npc_poison_start($poison_severity);
    }
}

//mes("attackstyle: <tostring(%attackstyle)>, damagestyle: <tostring(%damagestyle)>, damage: <tostring($damage)>, damagetype: <tostring(%damagetype)>");
anim(%com_attackanim, 0);
sound_synth(%com_attacksound, 0, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20); 
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 0, 20); // delay npc this tick
}
// set the skill clock depending on the weapon attack rate
%action_delay = add(map_clock, $attack_rate);

p_opnpc(2);

[proc,get_seq](seq $seq)(seq)
return ($seq);