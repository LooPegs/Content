[debugproc,cam]
cam_moveto(movecoord(coord, 0, 0, -8), 2500, 0, 100);
cam_lookat(movecoord(coord, 0, 0, 2), 1276, 0, 100);
//p_delay(0); //walktrigger gets messed up if you are moving while this procs
walktrigger(lean_on_wall);

[debugproc,favor]
if (p_finduid(uid) = true) {
    mes("Forester favor : <tostring(%favor_test)>");
}
[debugproc,resetfavor]
if (p_finduid(uid) = true) {
    %favor_skipped = false;
    ~reset_task;
}
[debugproc,favor2]
if (p_finduid(uid) = true) {
    %favor_taskgiver = 2;
}
[debugproc,suff]
if (p_finduid(uid) = true) {
    ~mesbox("Warning: Items placed in the crate can't be taken out!");
}

[debugproc,inv]
~trail_clue_hard_rare;
inv_transmit(trail_rewardinv, trail_reward:inv);
if_openmain(trail_reward);
queue(trail_give_reward, 0);

[debugproc,inv2]
if (p_finduid(uid) = true) {
    mes("inv2");
    inv_transmit(bank, party_drop_chest:inv);
    if_openmain_side(party_drop_chest, party_drop_chest_side);
}

[debugproc,inv3]
if (p_finduid(uid) = true) {
    mes("inv3");
    ~trail_clue_hard_rare;
    inv_transmit(trail_rewardinv, party_drop_chest:inv);
    if_openmain_side(party_drop_chest, party_drop_chest_side);
}

[debugproc,inv4]
if (p_finduid(uid) = true) {
    mes("inv4");
    ~trail_clue_hard_rare;
    inv_transmit(partyroom_dropinv, party_drop_chest:inv);
    if_openmain_side(party_drop_chest, party_drop_chest_side);
}

[debugproc,synth](synth $sound)
if ($sound = null) {
    @debugusage("::synth (name)", "::synth liquid", "");
    return;
}
sound_synth($sound, 0, 0);

[debugproc,test]
sound_synth(liquid, 0, 0);
sound_synth(ogre_bellows, 0, 1);
sound_synth(smash_gem, 0, 2);
sound_synth(air_elemental_attack, 0, 3);

spotanim_pl(attacksword, 128, 0);
spotanim_pl(zap, 128, 100);
spotanim_pl(sp_attackglow_blue, 128, 200);

