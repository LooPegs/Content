[ai_queue3,gnomechildblue]
    gosub(npc_death);
    if (npc_findhero = ^false) {
        return;
    }
    obj_add(npc_coord, sapphire, 1, ^lootdrop_duration);

[ai_queue3,gnomechildgreen]
    gosub(npc_death);
    if (npc_findhero = ^false) {
        return;
    }
    obj_add(npc_coord, emerald, 1, ^lootdrop_duration);
    
