[proc,rest_heal]
anim(null, 0);
p_stopaction;
~stat_reset_noncombat;
healenergy(10000);
stat_heal(hitpoints, 0, 50);
~combat_clearqueue;
clearqueue(player_death_default);
~clear_pk_skull;
~clear_poison;
~update_all(inv_getobj(worn, ^wearpos_rhand));
hint_stop;
~sa_reset;

[proc,start_sleep_timer](int $duration)
clearsofttimer(sleep_timer);
softtimer(sleep_timer, $duration);
%sleep = add(map_clock, $duration);

[softtimer,sleep_timer]
~reset_sleep;

[proc,reset_sleep]
clearsofttimer(sleep_timer);
%sleep = 0;

[proc,grant_sleep_xp]
def_stat $stat1;
def_stat $stat2;
def_stat $stat3;

if (%sleep_xp1_type = 0) {
    %sleep_xp1_type, %sleep_xp1 = ~loop_remaining;
}
if (%sleep_xp1_type > 0 & %sleep_xp1 >= 10) {
    $stat1 = enum(int, stat, stats, %sleep_xp1_type);
    stat_advance($stat1, %sleep_xp1);
    mes("You gained <tostring(scale(%sleep_xp1, 10, 1))> <enum(stat, string, stat_names, $stat1)> XP!");
}

if (%sleep_xp2_type = 0) {
    %sleep_xp2_type, %sleep_xp2 = ~loop_remaining;
}
if (%sleep_xp2_type > 0 & %sleep_xp2 >= 10) {
    $stat2 = enum(int, stat, stats, %sleep_xp2_type);
    stat_advance($stat2, %sleep_xp2);
    mes("You gained <tostring(scale(%sleep_xp2, 10, 1))> <enum(stat, string, stat_names, $stat2)> XP!");
}

if (%sleep_xp3_type = 0) {
    %sleep_xp3_type, %sleep_xp3 = ~loop_remaining;
}
if (%sleep_xp3_type > 0 & %sleep_xp3 >= 10) {
    $stat3 = enum(int, stat, stats, %sleep_xp3_type);
    stat_advance($stat3, %sleep_xp3);
    mes("You gained <tostring(scale(%sleep_xp3, 10, 1))> <enum(stat, string, stat_names, $stat3)> XP!");
}
~reset_sleep_xp;

[proc,loop_remaining]()(int, int)
//if not all xp is capped out, find next highest
//returns max_type, max_xp
def_int $i = 1;
def_int $max_xp = 0;
def_int $max_type = 0;
def_int $temp_xp;
while ($i < 20) {
    switch_int($i) {
        //no hitpoints
        case 7 : $temp_xp = %sleep_agility;
        case 1 : $temp_xp = %sleep_attack;
        case 16 : $temp_xp = %sleep_cooking;
        case 11 : $temp_xp = %sleep_crafting;
        case 5 : $temp_xp = %sleep_defence;
        case 17 : $temp_xp = %sleep_firemaking;
        case 15 : $temp_xp = %sleep_fishing;
        case 19 : $temp_xp = %sleep_fletching;
        case 9 : $temp_xp = %sleep_herblore;
        case 4 : $temp_xp = %sleep_magic;
        case 13 : $temp_xp = %sleep_mining;
        case 7 : $temp_xp = %sleep_prayer;
        case 3 : $temp_xp = %sleep_ranged;
        case 12 : $temp_xp = %sleep_runecraft;
        case 14 : $temp_xp = %sleep_smithing;
        case 2 : $temp_xp = %sleep_strength;
        case 10 : $temp_xp = %sleep_thieving;
        case 18 : $temp_xp = %sleep_woodcutting;
        case default : $temp_xp = 0;
    }
    mes("i=<tostring($i)>. temp xp=<tostring($temp_xp)>");
    if ($temp_xp > $max_xp & ~is_capped($i) = false) {
        mes("^^yep that's a new max");
        $max_xp = $temp_xp;
        $max_type = $i;
    }
    $i = add($i, 1);
}
return ($max_type, $max_xp);

[proc,is_capped](int $stat_int)(boolean)
//return true if the given stat (numerical) is currently capped for bonus sleep xp
if ($stat_int = %sleep_xp1_type | $stat_int = %sleep_xp2_type | $stat_int = %sleep_xp3_type) {
    return (true);
}
return (false);

[proc,reset_sleep_xp]
%sleep_xp1_type = 0;
%sleep_xp1 = 0;
%sleep_xp2_type = 0;
%sleep_xp2 = 0;
%sleep_xp3_type = 0;
%sleep_xp3 = 0;
%sleep_agility = 0;
%sleep_attack = 0;
%sleep_cooking = 0;
%sleep_crafting = 0;
%sleep_defence = 0;
%sleep_firemaking = 0;
%sleep_fishing = 0;
%sleep_fletching = 0;
%sleep_herblore = 0;
%sleep_magic = 0;
%sleep_mining = 0;
%sleep_prayer = 0;
%sleep_ranged = 0;
%sleep_runecraft = 0;
%sleep_smithing = 0;
%sleep_strength = 0;
%sleep_thieving = 0;
%sleep_woodcutting = 0;

[proc,stat_advance_boostable](stat $stat, int $amount)
stat_advance($stat, $amount);
if (%sleep <= 0 ) {
    return;
}
mes("tracking xp: stat1 slot: <enum(stat, string, stat_names, enum(int, stat, stats, %sleep_xp1_type))>");

if (enum(int, stat, stats, %sleep_xp1_type) = $stat) {
    mes("full!");
    return;
}
if (enum(int, stat, stats, %sleep_xp2_type) = $stat) {
    mes("full!");
    return;
}
if (enum(int, stat, stats, %sleep_xp3_type) = $stat) {
    mes("full!");
    return;
}

//check if sleep xp is full already
if (%sleep_xp3 > 0) {
    return;
}
~track_sleep_xp($stat, $amount);


[proc,get_sleep_xp_cap](int $stat_int)(int)

if ($stat_int >= 80) {
    return (2500);
}
else if ($stat_int >= 60) {
    return (2000);
}
else if ($stat_int >= 40) {
    return (1500);
}
else if ($stat_int >= 20) {
    return (1000);
}
else {
    return (500);
}

[proc,track_sleep_xp](stat $stat, int $amount)

def_int $cap = ~get_sleep_xp_cap(enum(stat, int, stats_reverse, $stat));
switch_stat($stat) {
    case attack :
        %sleep_attack = add(%sleep_attack, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_attack >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case strength :
        %sleep_strength = add(%sleep_strength, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_strength >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case defence :
        %sleep_defence = add(%sleep_defence, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_defence >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case magic :
        %sleep_magic = add(%sleep_magic, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_magic >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case ranged :
        %sleep_ranged = add(%sleep_ranged, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_ranged >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    //nerfed
    case prayer :
        %sleep_prayer = add(%sleep_prayer, scale($amount, ^nerfed_sleep_xp_divisor, 1));
        if (%sleep_prayer >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case agility :
        %sleep_agility = add(%sleep_agility, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_agility >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case thieving :
        %sleep_thieving = add(%sleep_thieving, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_thieving >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case fishing :
        %sleep_fishing = add(%sleep_fishing, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_fishing >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case cooking :
        %sleep_cooking = add(%sleep_cooking, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_cooking >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case firemaking :
        %sleep_firemaking = add(%sleep_firemaking, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_firemaking >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case woodcutting :
        %sleep_woodcutting = add(%sleep_woodcutting, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_woodcutting >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case mining :
        %sleep_mining = add(%sleep_mining, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_mining >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    //nerfed
    case smithing :
        %sleep_smithing = add(%sleep_smithing, scale($amount, ^nerfed_sleep_xp_divisor, 1));
        if (%sleep_smithing >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case runecraft :
        %sleep_runecraft = add(%sleep_runecraft, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_runecraft >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    //nerfed
    case crafting :
        %sleep_crafting = add(%sleep_crafting, scale($amount, ^nerfed_sleep_xp_divisor, 1));
        if (%sleep_crafting >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case fletching :
        %sleep_fletching = add(%sleep_fletching, scale($amount, ^sleep_xp_divisor, 1));
        if (%sleep_fletching >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    //nerfed
    case herblore :
        %sleep_herblore = add(%sleep_herblore, scale($amount, ^nerfed_sleep_xp_divisor, 1));
        if (%sleep_herblore >= $cap) {
            ~store_sleep_xp($stat, $cap);
        }
    case default :
        // no bonus Hitpoints xp
        return;
}
[proc,store_sleep_xp](stat $stat, int $amount)

mes("Attempting to store <tostring($amount)> <enum(stat, string, stat_names, $stat)> XP.");

if (%sleep_xp1 = 0) {
    %sleep_xp1 = $amount;
    %sleep_xp1_type = enum(stat, int, stats_reverse, $stat);
}
else if (%sleep_xp2 = 0) {
    %sleep_xp2 = $amount;
    %sleep_xp2_type = enum(stat, int, stats_reverse, $stat);
}
else if (%sleep_xp3 = 0) {
    %sleep_xp3 = $amount;
    %sleep_xp2_type = enum(stat, int, stats_reverse, $stat);
}


[proc,set_sleep_logout]
if (%sleep < 1) {
    return;
}
%sleep = sub(%sleep, map_clock);

[proc,set_sleep_login]
if (%sleep < 1) {
    return;
}
~start_sleep_timer(%sleep);