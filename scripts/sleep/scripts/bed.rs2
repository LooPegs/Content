[oploc1,_bed]
mes("sleep_prayer = <tostring(%sleep_prayer)>");
anim(human_getinbed, 0);
mes("You lie down...");
p_delay(1);
if (%sleep > 0) {
    ~mesbox("You're not tired enough to fall asleep yet.");
    mes("Sleep:<tostring(sub(%sleep, map_clock))>");
    return;
}
mes("...");
p_delay(1);
mes("You wake up refreshed.");
//mes("Sleep:<tostring(sub(%sleep, map_clock))>");
~sleep_reset_stats;
~grant_sleep_xp;
~start_sleep_timer(^sleep_timer_duration);

[proc,sleep_reset_stats]
anim(null, 0);
p_stopaction;
~stat_reset_all;
healenergy(10000);
~combat_clearqueue;
clearqueue(player_death_default);
~clear_pk_skull;
~clear_poison;
~update_all(inv_getobj(worn, ^wearpos_rhand));
hint_stop;
~sa_reset;

[proc,start_sleep_timer](int $duration)
clearsofttimer(sleep_timer);
softtimer(sleep_timer, $duration);
%sleep = add(map_clock, $duration);

[softtimer,sleep_timer]
~reset_sleep;

[proc,reset_sleep]
clearsofttimer(sleep_timer);
%sleep = 0;

[proc,set_sleep_logout]
if (%sleep < 1) {
    return;
}
%sleep = sub(%sleep, map_clock);

[proc,set_sleep_login]
if (%sleep < 1) {
    return;
}
~start_sleep_timer(%sleep);
